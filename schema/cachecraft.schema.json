{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mturac/CacheCraft/main/schema/cachecraft.schema.json",
  "title": "CacheCraft prompt plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 1
    },
    "cacheKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "providerOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "explicit",
                "implicit"
              ]
            }
          }
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "automatic": {
              "type": "boolean"
            },
            "automaticHorizon": {
              "enum": [
                "long",
                "short"
              ]
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "inputSchema": {
            "type": "object"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "stability",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "enum": [
              "instructions",
              "conversation"
            ]
          },
          "stability": {
            "enum": [
              "global",
              "deployment",
              "session",
              "turn",
              "request"
            ]
          },
          "order": {
            "enum": [
              "optimize",
              "preserve"
            ],
            "default": "preserve"
          },
          "before": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cache": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "horizon"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "required",
                  "preferred",
                  "never"
                ]
              },
              "horizon": {
                "enum": [
                  "long",
                  "short"
                ]
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
